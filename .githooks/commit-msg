#!/bin/sh
# sin-e-phile commit-msg hook — Conventional Commits, per SPEC.md §10.5.
#
# Format:  type(scope): subject
# Example: feat(torrent): implement sequential piece scheduler

MSG_FILE="$1"
FIRST_LINE=$(head -n1 "$MSG_FILE")

# Merges, reverts and fixups are generated by git; do not police them.
case "$FIRST_LINE" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,}$'

if ! printf '%s' "$FIRST_LINE" | grep -Eq "$PATTERN"; then
    echo "" >&2
    echo "commit-msg: subject does not follow Conventional Commits (SPEC.md §10.5)." >&2
    echo "" >&2
    echo "  got:      $FIRST_LINE" >&2
    echo "  expected: type(scope): subject" >&2
    echo "" >&2
    echo "  types: feat fix docs style refactor perf test build ci chore revert" >&2
    echo "  e.g.   feat(torrent): implement sequential piece scheduler" >&2
    echo "         docs(adr): record librqbit decision" >&2
    echo "" >&2
    exit 1
fi

if [ ${#FIRST_LINE} -gt 72 ]; then
    echo "commit-msg: subject is ${#FIRST_LINE} chars; keep it under 72." >&2
    exit 1
fi
